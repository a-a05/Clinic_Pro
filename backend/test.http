### ==========================================
### المرحلة 2: إدارة المرضى (Patients)
### ==========================================

### أ. إضافة مريض (عمر) من قبل موظف الاستقبال
POST {{baseUrl}}/patients/add
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
  "nationalId": "9951001234",
  "firstName": "Omar",
  "secondName": "Ali",
  "thirdName": "Ahmad",
  "lastName": "Khaled",
  "dateOfBirth": "1995-05-15",
  "gender": "Male",
  "address": "Amman, Jordan",
  "phoneNo": "0780000000",
  "email": "omar@example.com"
}

### ب. مريض (سامي) بيسجل لحاله أونلاين (عبر البوت أو الموقع)
POST {{baseUrl}}/auth/register-online
Content-Type: application/json

{
    "firstName": "ahmad",
    "lastName": "alherbawi",
    "phoneNo": "0785340671",
    "email": "ahmad.alherbawi2005@gmail.com",
    "username": "ahmad321",
    "password": "password123"
}

### ج. عرض جميع المرضى (صلاحية الاستقبال)
GET {{baseUrl}}/patients
Authorization: Bearer {{recToken}}

### ==========================================
### المرحلة 3: المواعيد (Appointments)
### ==========================================

### أ. حجز موعد (من قبل الاستقبال للمريض رقم 1 عند الدكتور رقم 2)
POST {{baseUrl}}/appointments/add
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
  "patientId": 1,
  "doctorUserId": 2,
  "appointmentDate": "2026-10-30",
  "startsAt": "2026-10-30T10:00:00Z",
  "endsAt": "2026-10-30T10:30:00Z",
  "reason": "Toothache and checkup",
  "appointmentStatus": "Scheduled"
}

### ب. عرض المواعيد بصلاحية الاستقبال (رح يجيب كل مواعيد العيادة)
GET {{baseUrl}}/appointments
Authorization: Bearer {{recToken}}

### ج. عرض المواعيد بصلاحية الدكتور (رح يجيب مواعيده هو بس)
GET {{baseUrl}}/appointments
Authorization: Bearer {{doctorToken}}

### ==========================================
### المرحلة 4: الجلسة السريرية (Visits & Notes)
### ==========================================

### أ. تسجيل وصول المريض (Check-in) - الاستقبال
POST {{baseUrl}}/visits/check-in
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
    "appointmentId": 1
}

### ب. إدخال المريض للطبيب (Started) - الاستقبال أو الطبيب
PUT {{baseUrl}}/visits/1/status
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
    "status": "Started"
}

### ج. كتابة الملاحظات الطبية (Visit Notes) - الدكتور فقط
POST {{baseUrl}}/visits/note
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
    "visitId": 1,
    "noteText": "The patient suffers from a minor cavity in the lower right molar. Needs a filling in the next session."
}

### د. إنهاء الجلسة (Ended) - الدكتور أو الاستقبال
PUT {{baseUrl}}/visits/1/status
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
    "status": "Ended"
}

### ==========================================
### المرحلة 5: الخطط العلاجية (Treatments)
### ==========================================

### أ. إنشاء خطة علاجية للمريض رقم 1 - الدكتور فقط
POST {{baseUrl}}/treatments/plan
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
    "patientId": 1,
    "planName": "General Checkup and Fillings",
    "planStatus": "Active"
}

### ب. إضافة إجراء (حشوة) للخطة رقم 1 - الدكتور فقط
POST {{baseUrl}}/treatments/item
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
    "planId": 1,
    "procedureName": "Composite Filling",
    "toothNumber": "46",
    "estimatedCost": 50.00,
    "itemStatus": "Planned"
}

### ج. عرض الخطط العلاجية للمريض رقم 1 - الدكتور فقط
GET {{baseUrl}}/treatments/1
Authorization: Bearer {{doctorToken}}

### ==========================================
### المرحلة 6: الفوترة والمالية (Invoices)
### ==========================================

### أ. إصدار فاتورة للزيارة رقم 1 - الاستقبال
POST {{baseUrl}}/invoices
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
    "patientId": 1,
    "visitId": 1,
    "totalAmount": 70.00,
    "invoiceStatus": "Unpaid"
}

### ب. تسجيل دفعة نقدية للفاتورة رقم 1 - الاستقبال
POST {{baseUrl}}/invoices/payment
Content-Type: application/json
Authorization: Bearer {{recToken}}

{
    "invoiceId": 1,
    "amount": 70.00,
    "method": "Cash"
}

### ج. عرض جميع الفواتير - المدير
GET {{baseUrl}}/invoices
Authorization: Bearer {{adminToken}}

